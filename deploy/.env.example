# 서버의 /home/ubuntu/station/.env 로 만들어 값을 채웁니다 (chmod 600). 절대 커밋하지 않습니다.
# 이미지 주소(IMAGE_URI)는 배포마다 CodeDeploy 번들의 image.env가 넣어 주므로 여기에 쓰지 않습니다.
# 고친 뒤 반영: sudo bash /home/ubuntu/station/current/scripts/start.sh

# 서버 도메인 (DNS A 레코드가 EC2 탄력적 IP를 가리켜야 HTTPS 발급이 됩니다)
DOMAIN=api.wait-station.online

# DB
POSTGRES_DB=station
POSTGRES_USER=station
POSTGRES_PASSWORD=change-me-long-random

# 인증 토큰 서명 키 (32바이트 이상 랜덤 문자열: openssl rand -base64 32)
JWT_SECRET=change-me-at-least-32-bytes-random-string

# 프론트 주소 (CORS 허용, 쉼표로 여러 개)
CORS_ALLOWED_ORIGINS=https://frontend.example.com

# 열차 간격(초): 데모는 15, 실제 1시간은 3600
TRAIN_INTERVAL_SECONDS=15

# ---- 서버 크기에 맞춘 메모리 설정 ----
# 비워 두면 2GB 서버 값(아래 첫 번째 묶음)이 기본으로 쓰입니다.
# APP_MEM_LIMIT은 힙(-Xmx)보다 400~600MB 크게 잡습니다 (메타스페이스, 스레드 등 힙 밖 메모리).
#
# 2GB 서버 (t8i.small, 평소 개발용)
JAVA_OPTS="-Xms256m -Xmx512m"
APP_MEM_LIMIT=900m
DB_MEM_LIMIT=384m
#
# 4GB 서버 (c7i-flex.large, 시연·부하 테스트용) — 위 세 줄 대신 사용
# JAVA_OPTS="-Xms512m -Xmx1536m"
# APP_MEM_LIMIT=2200m
# DB_MEM_LIMIT=768m
