/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary

# 서버(Linux)에서 실행·해석되는 파일은 Windows에서 체크아웃해도 LF로 유지합니다.
# CRLF가 섞이면 bash가 "$'\r': command not found"로 실패합니다.
*.sh text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.tfvars.example text eol=lf
*.hcl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
deploy/Caddyfile text eol=lf
deploy/.env.example text eol=lf
