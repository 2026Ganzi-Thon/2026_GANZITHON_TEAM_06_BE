# [로컬 전용] 이 파일을 복사해서 .env로 만들면 docker compose와 Spring(local 프로필)이 함께 읽습니다.
# 아무것도 바꾸지 않을 거라면 .env 없이도 기본값으로 동작합니다. .env는 커밋하지 않습니다.
# 배포(prod 프로필)는 .env를 읽지 않습니다. 필요한 환경변수는 application.yml의 prod 구역을 보세요.

# DB (docker-compose.yml과 application.yml local 구역이 같이 씀)
DB_NAME=station
DB_USERNAME=station
DB_PASSWORD=station
DB_PORT=5432

# 열차 간격(초): 실제 서비스는 30분(1800), 시연 영상 촬영은 20. 로컬 기본은 20
TRAIN_INTERVAL_SECONDS=20

# 대기실 하나의 좌석 수 (기본 36 = 의자 12개 × 3명). 다 차면 서서 기다립니다
# SEAT_COUNT=36

# CORS 허용 Origin: 쉼표로 여러 개, 패턴(*) 가능
# 로컬 권장: http://localhost:*
# 배포 권장: https://{프론트 주소},http://localhost:*
CORS_ALLOWED_ORIGINS=http://localhost:*

# 계정 토큰 서명 키 (로컬은 기본값이 있어서 비워 둬도 됨. 배포에서는 32바이트 이상 랜덤 값 필수)
# JWT_SECRET=
