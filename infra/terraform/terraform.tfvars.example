# 복사해서 terraform.tfvars로 만들고 값을 채웁니다. terraform.tfvars는 커밋하지 않습니다 (.gitignore).
#   Copy-Item terraform.tfvars.example terraform.tfvars
# 비밀값(DB 비밀번호, JWT 키)은 여기에 넣지 않습니다. 서버 /home/ubuntu/station/.env에만 둡니다.

# 필수: 예산 알림 받을 이메일
budget_email = "you@example.com"

# 월 예산 한도(USD)
budget_limit_usd = 20

# EC2 유형: 평소 t8i.small(2GB), 시연 전 c7i-flex.large(4GB)로 바꿔 apply
instance_type = "t8i.small"

# GitHub Actions의 AWS 로그인 방식
#   access_key: IAM 사용자 station-github-deploy (액세스 키는 apply 후 aws iam create-access-key로 직접 발급)
#   oidc      : GitHub OIDC (조직 SCP가 iam:*OpenIDConnectProvider*를 허용할 때만. deploy.yml도 같이 되돌려야 함)
auth_mode = "access_key"

# 아래는 기본값 그대로 두면 됩니다.
# region             = "ap-southeast-2"
# project            = "station"
# github_org         = "2026Ganzi-Thon"
# github_repo        = "2026_GANZITHON_TEAM_06_BE"
# github_branch      = "dev"
# deploy_bucket_name = "station-deploy-<계정ID>"   # 비워 두면 자동
